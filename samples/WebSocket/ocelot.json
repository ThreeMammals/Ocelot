{
  "Routes": [
    {
      "UpstreamPathTemplate": "/ws",
      "DownstreamPathTemplate": "/WebSocket/EchoWebSocket.ashx",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        {
          "Host": "corefx-net-http11.azurewebsites.net",
          "Port": 80
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/wss",
      "DownstreamPathTemplate": "/",
      "DownstreamScheme": "wss",
      "DownstreamHostAndPorts": [
        {
          "Host": "echo.websocket.org",
          "Port": 443
        }
      ],
      "WebSocket": {
        "BufferSize": 65536
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7777" // "http://localhost:5555"
  }
}
